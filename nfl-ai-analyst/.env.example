# Copia este archivo a .env. Nunca subas .env al repositorio.

# Clave de la API de Anthropic (Claude) para resumir noticias.
# Sin clave, el script igual muestra lesiones y titulares, solo sin resumen.
ANTHROPIC_API_KEY=

# Modelo de Claude para el resumen de noticias.
NFL_ANALYST_MODEL=claude-opus-5-5
